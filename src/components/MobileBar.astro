---
import Icon from './Icon.astro';
import { company, cta } from '@/data/business';
---
<div class="mbar" aria-label="Contact the shop">
  <a class="btn" href={`tel:${company.phoneRaw}`}><Icon name="phone" weight="fill" /> Call</a>
  <a class="btn btn--ghost" href={company.mapsUrl} rel="noopener" target="_blank"><Icon name="navigation-arrow" /> {cta.directions}</a>
</div>

<style>
  .mbar {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-mbar);
    gap: var(--s-3);
    padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
    background: rgb(12 13 15 / 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid var(--line);
  }
  .mbar .btn { flex: 1; }
  @media (max-width: 720px) {
    .mbar { display: flex; }
    :global(body) { padding-bottom: calc(74px + env(safe-area-inset-bottom)); }
  }
</style>
