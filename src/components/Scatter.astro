---
/**
 * Hardware scattered behind a section: bolts, nuts, springs and model trucks
 * (Higgsfield cutouts in src/assets/decor). Purely decorative and inert.
 *
 * depth 0..1: near things are larger, sharper and drift more as the section
 * scrolls past (CSS scroll-driven animation, no JS). Far things are blurred.
 * The parent section must be position: relative and clip its overflow.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Item = {
  name: string;
  x: string;
  y: string;
  size: number;
  rot?: number;
  depth?: number;
  hideMobile?: boolean;
};
export interface Props { items: Item[] }
const { items } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/decor/*.png', { eager: true });
const pick = (name: string) => {
  const f = files[`/src/assets/decor/${name}.png`];
  if (!f) throw new Error(`Scatter: no decor image named "${name}"`);
  return f.default;
};
---
<div class="scatter" aria-hidden="true">
  {items.map((it) => {
    const depth = it.depth ?? 0.5;
    return (
      <Image
        src={pick(it.name)}
        alt=""
        widths={[Math.round(it.size), Math.round(it.size * 2)]}
        sizes={`${it.size}px`}
        loading="lazy"
        class:list={['scatter__item', { 'is-far': depth < 0.4, 'hide-m': it.hideMobile }]}
        style={`--x:${it.x};--y:${it.y};--s:${it.size}px;--r:${it.rot ?? 0}deg;--dp:${depth}`}
      />
    );
  })}
</div>

<style>
  .scatter {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .scatter :global(.scatter__item) {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    height: auto;
    rotate: var(--r);
    opacity: calc(0.35 + var(--dp) * 0.55);
    filter: drop-shadow(0 24px 30px rgb(0 0 0 / 0.55));
  }
  .scatter :global(.scatter__item.is-far) {
    filter: blur(2px) drop-shadow(0 18px 24px rgb(0 0 0 / 0.5));
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .scatter :global(.scatter__item) {
        animation: scatter-drift linear both;
        animation-timeline: view();
      }
    }
  }
  @keyframes scatter-drift {
    from { translate: 0 calc(var(--dp) * 110px); }
    to { translate: 0 calc(var(--dp) * -110px); }
  }
  @media (max-width: 860px) {
    .scatter :global(.scatter__item) { width: calc(var(--s) * 0.6); opacity: calc(0.25 + var(--dp) * 0.4); }
    .scatter :global(.scatter__item.hide-m) { display: none; }
  }
</style>
