---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import badge from '@/assets/brand/badge.png';
import { company } from '@/data/business';

const links = [
  { href: '/#about', label: 'Our story' },
  { href: '/#services', label: 'Services' },
  { href: '/#plows', label: 'Plows' },
  { href: '/#parts', label: 'Parts' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/#visit', label: 'Visit' },
];
const path = Astro.url.pathname;
---

<div class="hdr-sentinel" data-hdr-sentinel aria-hidden="true"></div>
<header class="hdr" data-hdr>
  <div class="hdr__bar wrap">
    <a class="hdr__brand" href="/" aria-label={`${company.name}, home`}>
      <Image src={badge} alt="" width={96} height={96} class="hdr__badge" loading="eager" />
      <span class="hdr__word">
        <span class="hdr__name">McLeod’s</span>
        <span class="hdr__tag">Spring &amp; Chassis</span>
      </span>
    </a>

    <nav class="hdr__nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="hdr__actions">
      <a class="btn btn--sm hdr__call" href={`tel:${company.phoneRaw}`}>
        <Icon name="phone" weight="fill" size={16} />
        <span class="mono">{company.phone}</span>
      </a>
      <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="menu" data-burger>
        <span class="sr-only">Menu</span>
        <span class="hdr__line"></span>
        <span class="hdr__line"></span>
      </button>
    </div>
  </div>

  <div class="menu" id="menu" data-menu hidden>
    <nav aria-label="Mobile">
      <ul>
        {links.map((l, i) => (
          <li style={`--i:${i}`}><a href={l.href} data-close>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="menu__foot" style={`--i:${links.length}`}>
      <a class="btn" href={`tel:${company.phoneRaw}`}><Icon name="phone" weight="fill" /> Call {company.phone}</a>
      <p class="menu__addr">{company.address}</p>
    </div>
  </div>
</header>

<style>
  .hdr-sentinel { position: absolute; top: 0; height: 24px; width: 1px; }
  .hdr {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    border-bottom: 1px solid transparent;
    transition: background-color 300ms ease, border-color 300ms ease, backdrop-filter 300ms ease;
  }
  .hdr.is-solid {
    background: rgb(12 13 15 / 0.82);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom-color: var(--line);
  }
  .hdr__bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }
  .hdr__brand {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    text-decoration: none;
    flex: none;
  }
  .hdr__brand :global(.hdr__badge) { width: 48px; height: 48px; }
  .hdr__word { display: grid; line-height: 1; }
  .hdr__name {
    font-family: var(--font-display);
    font-stretch: 75%;
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .hdr__tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green-400);
    margin-top: 3px;
  }

  .hdr__nav { margin-left: auto; }
  .hdr__nav ul { display: flex; gap: var(--s-1); list-style: none; }
  .hdr__nav a {
    display: block;
    padding: 8px 12px;
    font-size: var(--t-sm);
    line-height: var(--lh-sm);
    font-weight: 600;
    color: var(--steel-200);
    text-decoration: none;
    transition: color 160ms ease, background-color 160ms ease;
  }
  .hdr__nav a:hover { color: var(--text); background: rgb(255 255 255 / 0.07); }
  .hdr__nav a[aria-current='page'] { color: var(--text); box-shadow: inset 0 -2px 0 var(--green-500); }

  .hdr__actions { display: flex; align-items: center; gap: var(--s-4); }
  .hdr__call .mono { font-weight: 600; letter-spacing: 0; }

  .hdr__burger {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .hdr__line {
    position: absolute;
    left: 11px;
    width: 22px;
    height: 2px;
    background: var(--text);
    transition: transform 420ms var(--ease-drawer), top 420ms var(--ease-drawer);
  }
  .hdr__line:nth-of-type(1) { top: 17px; }
  .hdr__line:nth-of-type(2) { top: 25px; }
  .hdr__burger[aria-expanded='true'] .hdr__line:nth-of-type(1) { top: 21px; transform: rotate(45deg); }
  .hdr__burger[aria-expanded='true'] .hdr__line:nth-of-type(2) { top: 21px; transform: rotate(-45deg); }

  .menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: var(--z-menu);
    padding: var(--s-7) var(--gutter) calc(var(--s-7) + env(safe-area-inset-bottom));
    background: rgb(12 13 15 / 0.96);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    opacity: 0;
    transition: opacity 320ms var(--ease-out);
  }
  .menu.is-open { opacity: 1; }
  .menu ul { list-style: none; display: grid; gap: var(--s-1); }
  .menu a[data-close] {
    display: block;
    padding: 8px 0;
    font-family: var(--font-display);
    font-stretch: 72%;
    font-weight: 800;
    font-size: var(--t-5xl);
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
  }
  .menu li,
  .menu__foot {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 500ms var(--ease-out), transform 600ms var(--ease-drawer);
    transition-delay: calc(80ms + var(--i) * 45ms);
  }
  .menu.is-open li,
  .menu.is-open .menu__foot { opacity: 1; transform: none; }
  .menu__foot { display: grid; gap: var(--s-4); }
  .menu__addr { color: var(--text-muted); font-size: var(--t-sm); }

  @media (max-width: 1100px) {
    .hdr__nav { display: none; }
    .hdr__actions { margin-left: auto; }
    .hdr__burger { display: block; }
  }
  @media (max-width: 560px) {
    .hdr__call { display: none; }
    .hdr__brand :global(.hdr__badge) { width: 42px; height: 42px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu li, .menu__foot { transform: none; transition: opacity 200ms ease; }
  }
</style>

<script>
  const hdr = document.querySelector<HTMLElement>('[data-hdr]');
  const sentinel = document.querySelector<HTMLElement>('[data-hdr-sentinel]');
  if (hdr && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => hdr.classList.toggle('is-solid', !e.isIntersecting)).observe(sentinel);
  } else hdr?.classList.add('is-solid');

  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (burger && menu && hdr) {
    const set = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      hdr.classList.toggle('menu-open', open);
      if (open) {
        hdr.classList.add('is-solid');
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-open'));
      } else {
        menu.classList.remove('is-open');
        setTimeout(() => { if (burger.getAttribute('aria-expanded') === 'false') menu.hidden = true; }, 320);
      }
    };
    burger.addEventListener('click', () => set(burger.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('[data-close]').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }
</script>
